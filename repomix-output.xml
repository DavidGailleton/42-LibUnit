#include "libft.h"

size_t	ft_strlcat(char *dst, const char *src, size_t size)
{
	size_t	i;
	size_t	j;

	i = 0;
	j = ft_strlen(dst);
	if (!size)
		return (ft_strlen(src));
	if (j >= size)
		return (ft_strlen(src) + size);
	while (src[i] && i < ((size - j) - 1))
	{
		dst[i + j] = src[i];
		i++;
	}
	dst[i + j] = '\0';
	return (j + ft_strlen(src));
}
</file>

