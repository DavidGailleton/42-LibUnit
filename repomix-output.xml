#include "libft.h"

int	ft_lstsize(t_list *lst)
{
	int		i;
	t_list	*first_node;

	if (!lst)
		return (0);
	first_node = lst;
	i = 1;
	while (lst->next)
	{
		lst = lst->next;
		if (lst == first_node)
			break ;
		i++;
	}
	return (i);
}
</file>

