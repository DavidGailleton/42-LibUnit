#include "libft.h"

char	*ft_strnstr(const char *big, const char *little, size_t len)
{
	size_t	little_len;
	size_t	big_len;
	size_t	i;

	i = 0;
	little_len = ft_strlen(little);
	big_len = ft_strlen(big);
	if (!little[0])
		return ((char *)big);
	while ((little_len + i) <= len && (little_len + i) <= big_len)
	{
		if (!ft_strncmp(&big[i], little, little_len))
			return ((char *)&big[i]);
		i++;
	}
	return (NULL);
}
