#include "libft.h"

static void	write_nbr(unsigned int n, int fd)
{
	if (n)
	{
		write_nbr(n / 10, fd);
		ft_putchar_fd(n % 10 + '0', fd);
	}
}

void	ft_putnbr_fd(int n, int fd)
{
	if (!n)
		ft_putchar_fd('0', fd);
	else if (n < 0)
	{
		ft_putchar_fd('-', fd);
		write_nbr(n * -1, fd);
	}
	else
		write_nbr(n, fd);
}
</file>

