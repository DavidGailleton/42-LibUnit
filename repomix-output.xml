#include "libft.h"

t_list	*ft_lstlast(t_list *lst)
{
	size_t	size;
	size_t	i;

	if (!lst)
		return (NULL);
	size = ft_lstsize(lst);
	i = 1;
	while (i < size)
	{
		lst = lst->next;
		i++;
	}
	return (lst);
}
